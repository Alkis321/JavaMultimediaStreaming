<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx/24.0.0"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.client.PlaySceneController"
      spacing="10.0"
      alignment="CENTER">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <WebView fx:id="webView" prefHeight="400.0" prefWidth="600.0"/>

    <Button fx:id="playButton" text="Hit me to play" onAction="#onPlayClicked"/>

    <Button fx:id="backButton" text="Back" onAction="#onBackClicked"/>
</VBox>
